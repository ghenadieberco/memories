##
## Memories — environment template (implementation plan §4).
## Copy to .env.local for development. In production these are Fly secrets.
## NEVER commit real values: .env* is gitignored except this file.
##
## ⚠️ FILL THIS IN WITH DEVELOPMENT VALUES, NOT PRODUCTION ONES — a Neon `dev`
## branch and the `-dev` Tigris bucket. See plan §4a for how to create both, and
## why they must be split together: a dev database pointed at the production
## bucket lets a local delete destroy objects the live app still serves.
##

# Public base URL of the app. Local dev uses localhost; production uses your domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Neon: database -------------------------------------------------------
# Use the POOLED connection string from the Neon console (it has "-pooler" in
# the host). Neon requires TLS.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/memories?sslmode=require

# --- Neon Auth (Managed Better Auth) --------------------------------------
# Wired up in Phase 1; leave blank until then.
#
# NEON_AUTH_BASE_URL: Neon console -> Auth -> Enable Auth -> Configuration tab.
#   Shape: https://ep-xxx.neonauth.us-east-1.aws.neon.tech/<dbname>/auth
# NEON_AUTH_COOKIE_SECRET: you generate it, 32+ chars: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# --- Object storage: Tigris ----------------------------------------------
# Created with `fly storage create`, which prints these values once.
# R2 alternative: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=https://fly.storage.tigris.dev
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Public/CDN base URL images are served from directly (never proxied by the app).
S3_PUBLIC_URL=https://your-bucket.fly.storage.tigris.dev

# --- Email: Resend --------------------------------------------------------
# Needed from Phase 1 (verification) onward. Sending to arbitrary addresses
# requires a verified domain in Resend.
RESEND_API_KEY=
